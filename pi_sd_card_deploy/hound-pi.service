[Unit]
Description=HOUND Raspberry Pi Safe Command Agent & Watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/hound_pi
ExecStart=/usr/bin/python3 -m hound_pi.server --update-on-start --web-port 8765 --tcp-port 8766
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
