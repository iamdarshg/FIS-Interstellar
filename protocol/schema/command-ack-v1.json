{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommandAck",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "type", "commandId", "accepted", "reason"],
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "command_ack"
    },
    "commandId": {
      "type": "string"
    },
    "accepted": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    }
  }
}
