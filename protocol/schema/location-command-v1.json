{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LocationCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "type", "id", "sentAtMs", "targetX", "targetY", "speed", "reason"],
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "location_command"
    },
    "id": {
      "type": "string"
    },
    "sentAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "targetX": {
      "type": "number"
    },
    "targetY": {
      "type": "number"
    },
    "speed": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "reason": {
      "type": "string"
    }
  }
}
