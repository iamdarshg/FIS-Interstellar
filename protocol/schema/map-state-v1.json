{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MapState",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "type", "timestampMs", "roverX", "roverY", "roverHeading", "objects"],
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "map_state"
    },
    "timestampMs": {
      "type": "integer",
      "minimum": 0
    },
    "roverX": {
      "type": "number"
    },
    "roverY": {
      "type": "number"
    },
    "roverHeading": {
      "type": "number"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "x", "y", "confidence", "distance", "angle", "lastSeenMs"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "distance": { "type": "number", "minimum": 0.0 },
          "angle": { "type": "number" },
          "lastSeenMs": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
